{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": [
      "dom"
    ],
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "vite/client"
    ]
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "vitest.config.ts",
    "vitest.config.mts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.mts"
  ],
  "references": [
    {
      "path": "../../packages/web-feature-login/tsconfig.lib.json"
    },
    {
      "path": "../../packages/web-feature-payment/tsconfig.lib.json"
    },
    {
      "path": "../../packages/web-feature-users/tsconfig.lib.json"
    },
    {
      "path": "../../packages/web-feature-organizations/tsconfig.lib.json"
    },
    {
      "path": "../../packages/web-feature-dashboard/tsconfig.lib.json"
    },
    {
      "path": "../../packages/web-layout/tsconfig.lib.json"
    },
    {
      "path": "../../packages/web-components/tsconfig.lib.json"
    },
    {
      "path": "../../packages/core-store-session/tsconfig.lib.json"
    },
    {
      "path": "../../packages/core-translations/tsconfig.lib.json"
    }
  ]
}
