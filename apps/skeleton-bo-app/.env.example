VITE_API_URL=http://localhost:8080
VITE_OAUTH_CLIENT_ID=oidc-client-backoffice
VITE_AUTH_COOKIE_NAME=skeleton-auth-store-bo
VITE_STATIC_ASSETS_URL=/static
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
VITE_SALES_URL=mailto:sales@example.com
VITE_SUPPORT_EMAIL=support@example.com
VITE_DOCUMENTATION_URL=https://example.com/docs
VITE_PAYWALL_PRODUCT_GROUP_ID=pg_pro
# Wherever the web app requires https (SSO provider addresses), accept http:// too — a local
# Keycloak, a local test site. Honoured by the dev server only: a production build refuses http://
# whatever this says (import.meta.env.DEV).
VITE_ALLOW_INSECURE_URLS=true
