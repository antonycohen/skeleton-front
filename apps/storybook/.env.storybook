# Every API call goes to this fake origin, where the Mock Service Worker answers (packages/storybook-support/src/msw).
VITE_API_URL=https://api.storybook.local
VITE_OAUTH_CLIENT_ID=storybook-client
VITE_AUTH_COOKIE_NAME=skeleton-auth-store-storybook
VITE_STATIC_ASSETS_URL=/static
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
VITE_SALES_URL=mailto:sales@example.com
VITE_SUPPORT_EMAIL=support@example.com
VITE_DOCUMENTATION_URL=https://example.com/docs
VITE_PAYWALL_PRODUCT_GROUP_ID=pg_pro
VITE_ALLOW_INSECURE_URLS=true
