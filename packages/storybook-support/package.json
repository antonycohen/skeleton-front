{
  "name": "@skeleton/storybook-support",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./preview": {
      "types": "./src/preview.ts",
      "import": "./src/preview.ts",
      "default": "./src/preview.ts"
    }
  },
  "nx": {
    "tags": [
      "type:storybook"
    ],
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "echo \"Typechecked by @skeleton/storybook (npx nx typecheck @skeleton/storybook)\""
        }
      }
    }
  }
}
