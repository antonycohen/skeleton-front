{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Workspace imports resolve through node_modules (the packages' exports), not the base `paths`.
    "paths": {},
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": []
}
